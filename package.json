{
  "name": "solaria",
  "version": "0.1.0",
  "description": "Solaria — Şehre Güç Ver: Babylon.js ile çok oyunculu izometrik enerji/şehir oyunu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "balance": "node tests/balance-sim.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
